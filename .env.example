# MemGo 环境变量示例 — cp .env.example .env 后按需修改
# 语法: KEY=VALUE; # 注释; 值含空格或 # 时用引号包裹。
# 已在 shell 里导出的变量优先, 不会被本文件覆盖。

# ---------- Postgres ----------
# 宿主机访问 make up 起的栈: localhost:8432 (compose 内容器互访用 postgres:5432)
POSTGRES_HOST=localhost
POSTGRES_PORT=8432
# 向量记忆库 (pgvector, default_config)
POSTGRES_DB=postgres
POSTGRES_COLLECTION_NAME=memories
# 应用库 (server 表, goose 迁移)
APP_DB_NAME=mem0_app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ---------- 认证 ----------
# 必填 (除非 AUTH_DISABLED=true): openssl rand -base64 48
JWT_SECRET=
ADMIN_API_KEY=
# 仅限本地开发: 打开后受保护接口全部开放
AUTH_DISABLED=false

# ---------- LLM / Embedder (OpenAI 兼容) ----------
OPENAI_API_KEY=
OPENAI_BASE_URL=
MEM0_DEFAULT_LLM_MODEL=gpt-5-mini
MEM0_DEFAULT_EMBEDDER_MODEL=text-embedding-3-small
# 其他 provider 的备选 key (provider 配置指向时使用)
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# ---------- Server ----------
PORT=8000
DASHBOARD_URL=http://localhost:3000
# 默认 /app/history/history.db 是容器内路径; 本地裸跑二进制建议 ./history/history.db
# HISTORY_DB_PATH=./history/history.db

# ---------- Dashboard ----------
# NEXT_PUBLIC_API_URL / API_INTERNAL_URL / NEXT_PUBLIC_INSTANCE_NAME 由 deploy/docker-compose.yaml 注入，无需在此配置
# 起 dashboard: make up-dashboard（端口 DASHBOARD_HOST_PORT，默认 3000）

# ---------- 杂项 ----------
# false 关闭遥测上报
MEM0_TELEMETRY=true
# mem0 目录布局 (cli/core 用)
# MEM0_DIR=
# memgo-migrate 直连 DSN (默认按上面 Postgres 变量拼装)
# APP_DB_DSN=
