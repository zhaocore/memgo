    "/api-keys": {
      "get": {
        "operationId": "list_keys_api_keys_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/KeyListItem"
                  },
                  "title": "Response List Keys Api Keys Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          },
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "List Keys",
        "tags": [
          "api-keys"
        ]
      },
