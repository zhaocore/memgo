  "info": {
    "description": "A REST API for managing and searching memories for your AI Agents and Apps.\n\n## Authentication\nSupports Bearer JWT tokens, per-user API keys via `X-API-Key` header, or the legacy `ADMIN_API_KEY` environment variable. Set `AUTH_DISABLED=true` for local development only.",
    "title": "Mem0 REST APIs",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
