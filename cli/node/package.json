{
  "name": "@zhaots/memgo-cli",
  "version": "0.2.13",
  "description": "The node CLI for memgo \u2014 the memory layer for AI agents",
  "type": "module",
  "bin": {
    "memgo": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "test": "tsup && vitest run",
    "test:watch": "vitest",
    "lint": "biome check --formatter-enabled=false src tests *.ts *.mjs telemetry-sender.cjs && eslint . --max-warnings 0",
    "lint:fix": "biome check --write --formatter-enabled=false src tests *.ts *.mjs telemetry-sender.cjs && eslint . --fix --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test:terminal": "python3 tests/package/terminal.py node dist/index.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "Apache-2.0",
  "author": "zhaocore",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhaocore/memgo",
    "directory": "cli/node"
  },
  "keywords": [
    "memgo",
    "memory",
    "ai",
    "agents",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "boxen": "^7.1.0",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.4",
    "commander": "^12.0.0",
    "ora": "^8.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.7.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-jsdoc": "^64.3.5",
    "globals": "^17.12.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.0"
  },
  "packageManager": "pnpm@11.21.0",
  "files": [
    "dist",
    "telemetry-sender.cjs",
    "README.md"
  ]
}
