{
  "name": "@memgo/cli",
  "version": "0.2.13",
  "description": "The official CLI for memgo — the memory layer for AI agents",
  "type": "module",
  "bin": {
    "memgo": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "Apache-2.0",
  "author": "zhaocore",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhaocore/memgo",
    "directory": "cli/node"
  },
  "keywords": [
    "memgo",
    "memory",
    "ai",
    "agents",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.4",
    "ora": "^8.0.0",
    "boxen": "^7.1.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.0",
    "@biomejs/biome": "^1.7.0",
    "@types/node": "^20.0.0"
  }
}
